# TNS public catalog (sqlite cache built from the daily CSV dump)
# ---------------------------------------------------------------------------

class TnsCatalog:
    def __init__(self, refresh=False):
        self.db_path = TNS_DB
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        self._ensure(refresh)
        self.csv_date = self._csv_date()

    def _csv_date(self):
        if not self.db_path.exists():
            return None
        try:
            con = sqlite3.connect(self.db_path)
            row = con.execute(
                "SELECT value FROM meta WHERE key='csv_date'"
            ).fetchone()
            con.close()
            return row[0] if row else None
        except sqlite3.Error:
            return None

    def _ensure(self, refresh):
        today = datetime.now(timezone.utc).date().isoformat()
        if not refresh and self._csv_date() == today:
            return
        tp.info("TNS catalog stale or missing - refreshing index")
        with tp.timed("Building TNS index"):
            self._rebuild()

    def _rebuild(self):
        tmp_db = self.db_path.with_suffix(".db.new")
        if tmp_db.exists():
            tmp_db.unlink()
        zpath = CACHE_DIR / "tns_public_objects.csv.zip"
        try:
            with requests.get(TNS_ZIP_URL, headers={"User-Agent": TNS_UA},
                              timeout=180, stream=True) as r:
                r.raise_for_status()
                with open(zpath, "wb") as f:
                    for chunk in r.iter_content(1 << 20):
                        f.write(chunk)
        except requests.RequestException as e:
            if self.db_path.exists():
                tp.warn(f"TNS download failed ({e}); using cached index")
                return
            raise RuntimeError(f"TNS download failed: {e}")

        cols = list(TNS_SCHEMA)
        con = sqlite3.connect(tmp_db)
        con.execute(
            "CREATE TABLE objects ("
            + ", ".join(f"{c} {TNS_SCHEMA[c]}" for c in cols)
            + ")"
        )
        con.execute("CREATE TABLE meta (key TEXT PRIMARY KEY, value TEXT)")

        def to_val(col, raw):
            if raw is None or raw == "":
                return None
            if col in REAL_COLS:
                try:
                    return float(raw)
                except ValueError:
                    return None
            return raw

        with zipfile.ZipFile(zpath) as zf:
            with zf.open(zf.namelist()[0]) as raw:
                # first line is a creation timestamp, not the header
                first = raw.readline().decode("utf-8", "replace").strip()
                csv_date = first[:10]
                reader = csv.DictReader(
                    io.TextIOWrapper(raw, encoding="utf-8")
                )
                batch = []
                for rec in reader:
                    batch.append(tuple(
                        to_val(c, rec.get(CSV_HEADER_MAP[c])) for c in cols
                    ))
                    if len(batch) >= 5000:
                        con.executemany(
                            "INSERT INTO objects VALUES ("
                            + ",".join("?" * len(cols)) + ")",
                            batch,
                        )
                        batch.clear()
                if batch:
                    con.executemany(
                        "INSERT INTO objects VALUES ("
                        + ",".join("?" * len(cols)) + ")",
                        batch,
                    )
        con.execute("INSERT INTO meta VALUES ('csv_date', ?)", (csv_date,))
        con.execute("CREATE INDEX idx_name ON objects(lower(name))")
        con.commit()
        con.close()
        os.replace(tmp_db, self.db_path)

    def _rows(self, sql, args=()):
        con = sqlite3.connect(self.db_path)
        con.row_factory = sqlite3.Row
        out = [dict(r) for r in con.execute(sql, args).fetchall()]
        con.close()
        return out

    def by_name(self, key):
        return self._rows(
            "SELECT * FROM objects WHERE lower(name) = ?", (key,)
        )

    def by_internal_name(self, name):
        # LIKE prefilter, then exact match on the comma-separated entries
        rows = self._rows(
            "SELECT * FROM objects WHERE internal_names LIKE ?",
            (f"%{name}%",),
        )
        lname = name.lower()
        return [
            r for r in rows
            if any(n.lower() == lname
                   for n in internal_names_list(r["internal_names"]))
        ]

    def cone(self, ra, dec, radius_arcsec):
        rad = radius_arcsec / 3600.0
        # split the RA box at the 0/360 wrap so nothing is missed
        if ra - rad < 0:
            ra_ranges = [(0.0, ra + rad), (ra - rad + 360.0, 360.0)]
        elif ra + rad > 360:
            ra_ranges = [(ra - rad, 360.0), (0.0, ra + rad - 360.0)]
        else:
            ra_ranges = [(ra - rad, ra + rad)]
        dec_lo, dec_hi = dec - rad, dec + rad
        rows = []
        for lo, hi in ra_ranges:
            rows.extend(self._rows(
                "SELECT * FROM objects WHERE ra BETWEEN ? AND ? "
                "AND dec BETWEEN ? AND ?",
                (lo, hi, dec_lo, dec_hi),
            ))
        out = []
        for r in rows:
            if r["ra"] is None or r["dec"] is None:
                continue
            sep = float(ang_sep_deg(ra, dec, r["ra"], r["dec"])) * 3600.0
            if sep <= radius_arcsec:
                r["_sep"] = sep
                out.append(r)
        out.sort(key=lambda r: r["_sep"])
        return out

    def by_dia_id(self, dia_id):
        # internal_names entries look like 'LSST-AP-DO-<diaObjectId>'
        return self._rows(
            "SELECT * FROM objects WHERE internal_names LIKE ?",
            (f"%{dia_id}%",),
        )

    def find_name(self, raw):
        """TNS rows matching an object name or internal name."""
        key = tns_key(raw)
        rows = self.by_name(key) if key else []
        if not rows:
            rows = self.by_internal_name(raw)
        return rows


class TnsLive:
    """Live per-object lookup on wis-tns.org; no API key needed.

    The public object page rejects the TNS guest marker with a 401,
    so this uses a plain browser User-Agent.
    """

    UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
          "(KHTML, like Gecko) Chrome/126.0 Safari/537.36")

    def __init__(self):
        self.s = requests.Session()
        self.s.headers["User-Agent"] = self.UA

    def lookup(self, slug):
        """Return a catalog-like row for /object/<slug>, or None."""
        try:
            r = self.s.get(f"{TNS_LIVE_BASE}{slug}", timeout=30,
                           allow_redirects=False)
        except requests.RequestException:
            return None
        # unknown slugs either 404 or 302 to the homepage; a real
        # object page is a 200 with an object title
        if r.status_code != 200 or 'id="page-title"' not in r.text:
            return None
        return self._parse(slug, r.text)

    @staticmethod
    def _field(html, name):
        m = re.search(rf'field-{re.escape(name)}">.*?<b>([^<]*)</b>',
                      html, re.S)
        return m.group(1).strip() if m else None

    @staticmethod
    def _num(text):
        try:
            return float(text)
        except (TypeError, ValueError):
            return None

    def _parse(self, slug, html):
        coords = None
        m = re.search(r'alter-value">(-?[0-9.]+)\s+(-?[0-9.]+)<', html)
        if m:
            coords = (float(m.group(1)), float(m.group(2)))
        title = ""
        m = re.search(r'page-title">\s*([^<]+)', html)
        if m:
            title = m.group(1).strip()
        prefix = title.replace(slug, "").strip() if slug in title else ""
        pairs = []
        seen = set()
        for m in re.finditer(
                r'cell-internal_name">([^<]*)</td>\s*'
                r'<td class="cell-groups">([^<]*)</td>', html):
            name = m.group(1).strip()
            if name and name not in seen:
                seen.add(name)
                pairs.append((name, m.group(2).strip()))
        ra = dec = None
        if coords:
            ra, dec = coords
        return {
            "objid": None,
            "prefix": prefix,
            "name": slug,
            "ra": ra,
            "dec": dec,
            "redshift": self._num(self._field(html, "redshift")),
            "type": self._field(html, "type"),
            "discoverydate": self._field(html, "discoverydate"),
            "discoverymag": self._num(self._field(html, "discoverymag")),
            "discmagfilter": self._field(html, "filter_name"),
            "reporting_group": self._field(html, "reporting_group_name"),
            "source_group": self._field(html, "source_group_name"),
            "internal_names": ",".join(n for n, _ in pairs),
            "_live_names": [f"{n} ({g})" if g else n
                            for n, g in pairs],
            "_live": True,
            "_sep": None,
        }


def live_tns_slugs(raw, tns_rows):
    """Candidate /object/ slugs for a live TNS lookup, best first."""
    cands = []
    key = tns_key(raw)
    if key:
        cands.append(key)
    if tns_rows and tns_rows[0].get("name"):
        cands.append(tns_rows[0]["name"])
    low = re.sub(r"[^a-z0-9]+", "", raw.lower())
    if low:
        cands.append(low)
    out = []
    for c in cands:
        c = re.sub(r"[^A-Za-z0-9_-]", "", c)
        if c and c not in out:
            out.append(c)
    return out


# ---------------------------------------------------------------------------
# LASAIR web search (no token needed; uses the public search form)
# ---------------------------------------------------------------------------

class LasairWeb:
    def __init__(self):
        self.s = requests.Session()
        self.s.headers["User-Agent"] = "lsstcheck/1.0"
        self._csrf = None

    def _token(self):
        if self._csrf is None:
            r = self.s.get(f"{LASAIR_BASE}/search/", timeout=30)
            r.raise_for_status()
            m = re.search(r'csrfmiddlewaretoken" value="([^"]+)', r.text)
            if not m:
                raise RuntimeError("No CSRF token on LASAIR search page")
            self._csrf = m.group(1)
        return self._csrf

    def search(self, query):
        """Run a LASAIR web search; returns [{id, ra, dec, sep}]."""
        r = self.s.post(
            f"{LASAIR_BASE}/search/",
            data={"csrfmiddlewaretoken": self._token(), "query": query},
            headers={"Referer": f"{LASAIR_BASE}/search/"},
            timeout=60,
        )
        r.raise_for_status()
        return self._parse(r.text)

    @staticmethod
    def _parse(html):
        m = re.search(r"<tbody>(.*?)</tbody>", html, re.S)
        if not m:
            return []
        out = []
        for row in re.findall(r"<tr>(.*?)</tr>", m.group(1), re.S):
            idm = re.search(r"/objects/(\d+)/", row)
            if not idm:
                continue
            cells = [
                re.sub(r"<[^>]+>", "", c).strip()
                for c in re.findall(r"<td[^>]*>(.*?)</td>", row, re.S)
            ]
            nums = []
            for c in cells[1:]:
                try:
                    nums.append(float(c))
                except ValueError:
                    pass
            rec = {"id": idm.group(1)}
            if len(nums) >= 2:
                rec["ra"], rec["dec"] = nums[0], nums[1]
            if len(nums) >= 3:
                rec["sep"] = nums[2]
            out.append(rec)
        return out

    @staticmethod
    def _photometry(page):
        """Parse the difference-photometry table into row dicts."""
        i = page.find('id="exportLightcurve"')
        if i < 0:
            return []
        j = page.find("</table>", i)
        if j < 0:
            return []
        rows = []
        for tr in re.findall(r"<tr[^>]*>(.*?)</tr>", page[i:j], re.S):
            cells = [
                unescape(re.sub(r"<[^>]+>", "", c)).strip()
                for c in re.findall(r"<td[^>]*>(.*?)</td>", tr, re.S)
            ]
            if len(cells) < 4:
                continue
            try:
                mjd = float(cells[0])
            except ValueError:
                continue
            nums = re.findall(r"[-+]?\d*\.?\d+(?:[eE][-+]?\d+)?",
                              cells[3])
            if len(nums) < 2:
                continue
            rows.append({
                "mjd": mjd,
                "utc": cells[1],
                "band": cells[2],
                "flux": float(nums[0]),
                "flux_err": float(nums[1]),
            })
        return rows

    def object_page(self, dia_id):
        """Fetch an object page; returns (coords, ndet, photometry)."""
        try:
            r = self.s.get(f"{LASAIR_BASE}/objects/{dia_id}/", timeout=60)
            if r.status_code != 200:
                return None
        except requests.RequestException:
            return None
        html = r.text
        coords = None
        m = re.search(r"lon=([0-9.]+)d&lat=(-?[0-9.]+)d", html)
        if m:
            coords = (float(m.group(1)), float(m.group(2)))
        ndet = None
        m = re.search(r"Detection Count</td>\s*<td[^>]*>\s*([0-9]+)", html)
        if m:
            ndet = int(m.group(1))
        return coords, ndet, self._photometry(html)


