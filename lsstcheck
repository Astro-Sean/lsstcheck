BAND_COLORS = {
    "u": "#9467bd", "g": "#2ca02c", "r": "#d62728",
    "i": "#ff7f0e", "z": "#1f77b4", "y": "#17becf",
}

# marker shape encodes the band so bands stay distinct in greyscale
BAND_MARKERS = {
    "u": "o", "g": "s", "r": "^", "i": "D", "z": "p", "y": "h",
}
MARKER_SPARES = ["X", "*", "P", "x", "+", "1", "2", "3", "4"]

# AB magnitude zeropoint for flux in nanoJanskys
FLUX_ZP_NJY = 31.4


def flux_to_mag(flux):
    """AB mag from difference flux in nJy; NaN where flux <= 0."""
    flux = np.asarray(flux, dtype=float)
    with np.errstate(divide="ignore", invalid="ignore"):
        safe = np.where(flux > 0, flux, 1.0)
        mag = FLUX_ZP_NJY - 2.5 * np.log10(safe)
    return np.where(flux > 0, mag, np.nan)


def flux_to_mag_err(flux, flux_err):
    """1-sigma magnitude error propagated from flux errors."""
    flux = np.asarray(flux, dtype=float)
    flux_err = np.asarray(flux_err, dtype=float)
    with np.errstate(divide="ignore", invalid="ignore"):
        return 1.0857 * flux_err / flux


def lightcurve_fig(phot, title):
    """Build the AB-mag lightcurve figure; returns the Figure.

    Marker shape encodes the band. Raw points plot faded with white
    faces underneath; filled markers of the same shape mark
    inverse-variance weighted nightly bins. Upper limits use open
    downward triangles in the band color.
    """
    import matplotlib.pyplot as plt

    by_band = {}
    for row in phot:
        by_band.setdefault(row["band"], []).append(row)

    fig, ax = plt.subplots(figsize=(8, 4.5))
    order = [b for b in "ugrizy" if b in by_band]
    order += [b for b in by_band if b not in order]
    markers = {}
    spares = iter(MARKER_SPARES)
    for band in order:
        markers[band] = BAND_MARKERS.get(band) or next(spares, "o")
    for band in order:
        marker = markers[band]
        rows = sorted(by_band[band], key=lambda r: r["mjd"])
        color = BAND_COLORS.get(band)
        det = [r for r in rows if r["flux"] > 0]
        lim = [r for r in rows if r["flux"] <= 0]
        if det:
            ax.errorbar(
                [r["mjd"] for r in det],
                flux_to_mag([r["flux"] for r in det]),
                yerr=flux_to_mag_err([r["flux"] for r in det],
                                     [r["flux_err"] for r in det]),
                fmt=marker, ms=4, capsize=2, elinewidth=0.6,
                color=color, alpha=0.25,
                markerfacecolor="white", markeredgecolor=color,
                markeredgewidth=0.8,
            )
        if lim:
            ax.plot(
                [r["mjd"] for r in lim],
                flux_to_mag([max(r["flux_err"], 1e-6)
                             for r in lim]),
                "v", ms=4, color=color, alpha=0.25,
                markerfacecolor="white", markeredgecolor=color,
                markeredgewidth=0.8,
            )
        bins = {}
        for r in rows:
            bins.setdefault(int(r["mjd"] + 0.25), []).append(r)
        bd_x, bd_y, bd_ye = [], [], []
        bl_x, bl_y = [], []
        for night in sorted(bins):
            rs = bins[night]
            w = np.array([1.0 / max(r["flux_err"], 1e-6) ** 2
                          for r in rs])
            f = np.array([r["flux"] for r in rs])
            fbar = float(np.sum(w * f) / np.sum(w))
            ebar = float(np.sqrt(1.0 / np.sum(w)))
            xm = float(np.mean([r["mjd"] for r in rs]))
            if fbar > 0:
                bd_x.append(xm)
                bd_y.append(float(flux_to_mag(fbar)))
                bd_ye.append(float(1.0857 * ebar / fbar))
            else:
                bl_x.append(xm)
                bl_y.append(float(flux_to_mag(max(ebar, 1e-6))))
        if bd_x:
            ax.errorbar(bd_x, bd_y, yerr=bd_ye, fmt=marker, ms=7,
                        capsize=3, elinewidth=1.0, color=color,
                        label=f"{band}-band (nightly)")
        if bl_x:
            ax.plot(bl_x, bl_y, "v", ms=7, color=color,
                    markerfacecolor="white", markeredgewidth=1.0,
                    label=f"{band}-band limits (nightly)")
    ax.set_xlabel("MJD")
    ax.set_ylabel("Difference mag (AB)")
    ax.set_title(title)
    ax.legend(fontsize=8)
    ax.grid(alpha=0.3)
    ax.invert_yaxis()
    fig.tight_layout()
    return fig


def write_lightcurve_csv(path, phot):
    """Write photometry rows to CSV; returns path."""
    cols = ["mjd", "utc", "band", "flux", "flux_err"]
    with open(path, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=cols + ["mag", "mag_err"])
        w.writeheader()
        for row in phot:
            rec = {k: row[k] for k in cols}
            if row["flux"] > 0:
                rec["mag"] = float(flux_to_mag(row["flux"]))
                rec["mag_err"] = float(
                    flux_to_mag_err(row["flux"], row["flux_err"]))
            else:
                rec["mag"] = rec["mag_err"] = ""
            w.writerow(rec)
    return path


# ---------------------------------------------------------------------------
# Rubin schedule (ObsLocTAP) and ConsDB exposures
# ---------------------------------------------------------------------------

def schedule_visits(hours=SCHEDULE_HOURS):
    cols = ("s_ra,s_dec,s_fov,t_min,t_max,em_min,em_max,priority,"
            "execution_status,target_name")
    r = requests.get(
        f"{OBSLOCTAP}/schedule",
        params={"time": hours, "columns": cols},
        timeout=90,
    )
    r.raise_for_status()
    return r.json()


def ra_box_ranges(ra, half_deg):
    """RA interval(s) for a box, splitting at the 0/360 wrap."""
    lo, hi = ra - half_deg, ra + half_deg
    if lo < 0:
        return [(0.0, hi), (lo + 360.0, 360.0)]
    if hi > 360:
        return [(lo, 360.0), (0.0, hi - 360.0)]
    return [(lo, hi)]


def exposure_rows(ra, dec, days=EXPOSURE_DAYS, box_deg=2.6):
    """Recent ConsDB exposures in a box around the target.

    Returns (rows, ok) so callers can tell "no coverage" apart from
    "the query failed".
    """
    now = Time.now().mjd
    ra_ranges = ra_box_ranges(ra, box_deg)
    dec_lo, dec_hi = max(-90.0, dec - box_deg), min(90.0, dec + box_deg)
    if dec_lo >= dec_hi:
        return [], True
    cols = "exposure_id,obs_start_mjd,band,s_ra,s_dec,target_name"
    rows = []
    for lo, hi in ra_ranges:
        pred = (
            f"obs_start_mjd > {now - days} AND s_ra > {lo} "
            f"AND s_ra < {hi} AND s_dec > {dec_lo} AND s_dec < {dec_hi}"
        )
        try:
            r = requests.get(
                f"{OBSLOCTAP}/exposures",
                params={
                    "columns": cols, "predicate": pred, "limit": 10000,
                },
                timeout=90,
            )
            r.raise_for_status()
            rows.extend(r.json())
        except (requests.RequestException, ValueError) as e:
            tp.warn(f"Exposure query failed: {e}")
            return rows, False
    return rows, True


