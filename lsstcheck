def osc8_link(url, text=None):
    """Terminal hyperlink (OSC 8); falls back to plain text."""
    text = text or url
    if sys.stdout.isatty() and os.environ.get("TERM", "") != "dumb":
        return f"\x1b]8;;{url}\x07{text}\x1b]8;;\x07"
    return text


def ang_sep_deg(ra1, dec1, ra2, dec2):
    """Angular separation in degrees; scalars or numpy arrays."""
    ra1, dec1, ra2, dec2 = [
        np.radians(np.asarray(x, dtype=float)) for x in (ra1, dec1, ra2, dec2)
    ]
    cosd = (np.sin(dec1) * np.sin(dec2)
            + np.cos(dec1) * np.cos(dec2) * np.cos(ra1 - ra2))
    return np.degrees(np.arccos(np.clip(cosd, -1.0, 1.0)))


def band_name(em_min, em_max):
    mid_um = 0.5 * (em_min + em_max) * 1e6
    return min(BAND_UM, key=lambda b: abs(BAND_UM[b] - mid_um))


def fmt_mjd_iso(mjd):
    return Time(mjd, format="mjd").isot[:16].replace("T", " ") + " UTC"


def iso_date(mjd):
    return Time(mjd, format="mjd").iso[:10]


# ---------------------------------------------------------------------------
# input parsing
# ---------------------------------------------------------------------------

TNS_NAME_RE = re.compile(r"^(?:at|sn|frb|ul|lbv)?\s*(\d{4}[a-z]{1,5})$",
                         re.I)
LSST_NAME_RE = re.compile(r"^LSST-[A-Za-z]+-DO-(\d+)$", re.I)
DIAOBJECTID_RE = re.compile(r"^\d{15,20}$")


def coord_value(tok, is_ra):
    """Parse one coordinate token: decimal degrees or sexagesimal."""
    if ":" in tok or any(c in tok.lower() for c in "hms"):
        unit = u.hourangle if is_ra else u.deg
        return Angle(tok, unit=unit).deg
    return float(tok)


def split_positionals(tokens):
    """Return (ra_deg, dec_deg, radius_arcsec|None) or None."""
    joined = " ".join(tokens).replace(",", " ")
    parts = joined.split()
    if len(parts) == 6:
        try:
            ra = Angle(" ".join(parts[:3]), unit=u.hourangle).deg
            dec = Angle(" ".join(parts[3:]), unit=u.deg).deg
            return ra, dec, None
        except (ValueError, u.UnitsError):
            return None
    if len(parts) in (2, 3):
        try:
            ra = coord_value(parts[0], is_ra=True)
            dec = coord_value(parts[1], is_ra=False)
            radius = float(parts[2]) if len(parts) == 3 else None
            return ra, dec, radius
        except (ValueError, u.UnitsError):
            return None
    return None


def parse_target(tokens):
    """Classify user input into coords / name / diaObjectId."""
    pos = split_positionals(tokens)
    if pos is not None:
        return {"kind": "coords", "ra": pos[0], "dec": pos[1],
                "radius": pos[2]}

    raw = "".join(tokens).strip()
    if not raw:
        return None

    m = LSST_NAME_RE.match(raw)
    if m:
        return {"kind": "lsst_name", "raw": raw, "dia_id": m.group(1)}
    if DIAOBJECTID_RE.match(raw):
        return {"kind": "dia_id", "raw": raw, "dia_id": raw}

    return {"kind": "name", "raw": raw}


def tns_key(name):
    """Reduce 'AT2024lwa'/'SN 2024lwa' to the TNS key '2024lwa'."""
    m = TNS_NAME_RE.match(name.strip())
    return m.group(1).lower() if m else None


def internal_names_list(text):
    if not text:
        return []
    return [s.strip() for s in text.split(",") if s.strip()]


