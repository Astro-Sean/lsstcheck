def tns_display_name(row):
    prefix = row.get("prefix") or ""
    name = row.get("name") or ""
    return f"{prefix}{name}".strip() or str(row.get("objid", "?"))


def print_tns_section(rows, catalog_date=None, live_note=None):
    print()
    tp.header("TNS")
    if catalog_date:
        tp.info(f"Catalog date: {catalog_date}")
    if live_note:
        tp.info(live_note)
    if not rows:
        tp.info("No TNS entry for this target")
        return
    for row in rows[:3]:
        bits = [tns_display_name(row)]
        if row.get("source_group"):
            bits.append(row["source_group"])
        if row.get("type"):
            bits.append(row["type"])
        if row.get("redshift"):
            bits.append(f"z={row['redshift']}")
        if row.get("discoverydate"):
            bits.append(f"disc {row['discoverydate'][:10]}")
        if row.get("_sep") is not None:
            bits.append(f"sep {row['_sep']:.1f} arcsec")
        if row.get("_live"):
            bits.append("live")
        tp.ok(" | ".join(bits))
        names = row.get("_live_names")
        if not names:
            names = internal_names_list(row.get("internal_names"))
        if names:
            tp.info("Alternative names:")
            for n in names[:10]:
                print(f"    {n}")
            if len(names) > 10:
                print(f"    ... and {len(names) - 10} more")


def lsst_names_from_tns(tns_rows):
    names = []
    for row in tns_rows:
        for n in internal_names_list(row.get("internal_names")):
            if re.match(r"LSST-[A-Za-z]+-DO-\d+", n, re.I):
                names.append(n)
    return sorted(set(names))


def print_lsst_section(objects, tns_rows, detections=None):
    print()
    tp.header("LSST / LASAIR")
    lsst_names = lsst_names_from_tns(tns_rows)

    if not objects and not lsst_names:
        tp.info("No LSST alerts at this position")
        return

    table_rows = []
    links = []
    seen = set()
    for obj in objects:
        oid = obj["id"]
        if oid in seen:
            continue
        seen.add(oid)
        match = [n for n in lsst_names
                 if n.upper().endswith(f"-DO-{oid}")]
        lsst_name = ", ".join(match) if match else "-"
        sep = f"{obj['sep']:.1f}" if "sep" in obj else "-"
        table_rows.append((oid, lsst_name, sep))
        links.append(f"{LASAIR_BASE}/objects/{oid}/")
        if len(table_rows) >= 5:
            break
    if len(objects) > len(table_rows):
        table_rows.append((f"... +{len(objects) - len(table_rows)} more",
                           "", ""))
    if table_rows:
        tp.table(["diaObjectId", "LSST name", "Sep [arcsec]"],
                 table_rows)
        for url in links[:3]:
            tp.info(f"LASAIR: {osc8_link(url)}")
    if detections is not None:
        tp.info(f"Detections in LASAIR: {detections}")

    covered = {o["id"] for o in objects}
    for n in lsst_names:
        oid = re.search(r"-DO-(\d+)$", n, re.I)
        if oid and oid.group(1) not in covered:
            tp.info(f"LSST name (TNS only): {n}")


def upcoming_visits(visits, ra, dec, now_mjd, limit=5):
    need = ("s_ra", "s_dec", "t_min", "em_min", "em_max")
    visits = [v for v in visits
              if isinstance(v, dict) and all(k in v for k in need)]
    if not visits:
        return []
    s_ra = np.array([v["s_ra"] for v in visits], dtype=float)
    s_dec = np.array([v["s_dec"] for v in visits], dtype=float)
    sep = ang_sep_deg(ra, dec, s_ra, s_dec)
    fov_r = np.array(
        [v.get("s_fov", 3.5) / 2.0 for v in visits], dtype=float
    )
    hits = []
    for i, v in enumerate(visits):
        if v.get("execution_status") == "Aborted":
            continue
        if sep[i] < fov_r[i] and v["t_min"] > now_mjd - 0.03:
            hits.append((v["t_min"], float(sep[i]), v))
    hits.sort(key=lambda h: h[0])
    # collapse repeat pointings of the same epoch (~20 min) into one row
    kept, last_t = [], None
    for h in hits:
        if last_t is not None and h[0] - last_t < 20.0 / 1440.0:
            continue
        kept.append(h)
        last_t = h[0]
    return kept[:limit]


def schedule_horizon_h(visits, now_mjd):
    """How far ahead the published schedule actually reaches, in hours."""
    ends = [v["t_max"] for v in visits
            if isinstance(v, dict) and "t_max" in v]
    return (max(ends) - now_mjd) * 24.0 if ends else None


def schedule_viewer_url(ra, dec, hours=SCHEDULE_HOURS):
    """Schedule viewer URL pre-filtered to pointings near the target.

    The box is +/-2 deg, which contains every pointing whose center is
    within the ~1.75 deg field radius of the target.
    """
    half = 2.0
    dlo = max(-90.0, dec - half)
    dhi = min(90.0, dec + half)
    lo, hi = ra - half, ra + half
    if lo < 0:
        ra_pred = f"(s_ra>{lo + 360:.2f} OR s_ra<{hi:.2f})"
    elif hi > 360:
        ra_pred = f"(s_ra>{lo:.2f} OR s_ra<{hi - 360:.2f})"
    else:
        ra_pred = f"s_ra>{lo:.2f} AND s_ra<{hi:.2f}"
    pred = f"s_dec>{dlo:.2f} AND s_dec<{dhi:.2f} AND {ra_pred}"
    params = urlencode({"start": "now", "time": hours,
                        "predicate": pred})
    return f"{SCHEDULE_VIEWER}?{params}"


def skymap_url(hours=SCHEDULE_HOURS):
    return f"{OBSLOCTAP}/skymap?start=now&time={hours}"


def covered_nights(rows, ra, dec):
    """Map night index -> [(mjd, exposure)] for exposures covering target."""
    rows = [e for e in rows
            if isinstance(e, dict)
            and all(k in e for k in
                    ("s_ra", "s_dec", "obs_start_mjd"))]
    if not rows:
        return {}
    s_ra = np.array([float(e["s_ra"]) for e in rows])
    s_dec = np.array([float(e["s_dec"]) for e in rows])
    sep = ang_sep_deg(ra, dec, s_ra, s_dec)
    nights = {}
    for e, s in zip(rows, sep):
        if s >= FOV_RADIUS_DEG:
            continue
        mjd = float(e["obs_start_mjd"])
        nights.setdefault(int(mjd + 0.25), []).append((mjd, e))
    return nights


def scheduled_region_stats(visits, ra, dec, now_mjd,
                           radius_deg=REGION_RADIUS_DEG):
    """Summarize scheduled pointings near the target in the window.

    Wider than the FOV check - this asks whether the scheduler plans
    to observe the region at all, and in which bands. Returns a dict
    with night/pointing counts inside radius_deg, the band set, and
    the nearest pointing's time, separation, and band.
    """
    need = ("s_ra", "s_dec", "t_min", "em_min", "em_max")
    visits = [v for v in visits
              if isinstance(v, dict) and all(k in v for k in need)]
    out = {"nights": 0, "pointings": 0, "bands": [],
           "nearest_mjd": None, "nearest_sep": None,
           "nearest_band": None}
    if not visits:
        return out
    s_ra = np.array([float(v["s_ra"]) for v in visits])
    s_dec = np.array([float(v["s_dec"]) for v in visits])
    sep = ang_sep_deg(ra, dec, s_ra, s_dec)
    nights = set()
    bands = set()
    best = None
    for v, s in zip(visits, sep):
        if v.get("execution_status") == "Aborted":
            continue
        if v["t_min"] <= now_mjd - 0.03:
            continue
        s = float(s)
        if best is None or s < best[0]:
            best = (s, v)
        if s >= radius_deg:
            continue
        out["pointings"] += 1
        nights.add(int(v["t_min"] + 0.25))
        bands.add(band_name(v["em_min"], v["em_max"]))
    out["nights"] = len(nights)
    out["bands"] = sorted(bands)
    if best is not None:
        out["nearest_mjd"] = float(best[1]["t_min"])
        out["nearest_sep"] = best[0]
        out["nearest_band"] = band_name(best[1]["em_min"],
                                      best[1]["em_max"])
    return out


def print_schedule_section(ra, dec, days, sched_hours=SCHEDULE_HOURS):
    print()
    tp.header("Rubin Schedule")
    now = Time.now().mjd
    sched_ok = True
    try:
        visits = schedule_visits(sched_hours)
    except (requests.RequestException, ValueError) as e:
        tp.warn(f"Schedule query failed: {e}")
        visits = []
        sched_ok = False
    if not isinstance(visits, list):
        visits = []

    horizon_h = schedule_horizon_h(visits, now)
    hits = upcoming_visits(visits, ra, dec, now)
    if hits:
        tp.info("Scheduled visits covering this position:")
        rows = []
        for tmin, sep, v in hits:
            band = band_name(v["em_min"], v["em_max"])
            pri = {0: "next visit", 1: "1 h queue",
                   2: "24 h forecast"}.get(v.get("priority"), "?")
            prog = v.get("target_name") or "-"
            rows.append((fmt_mjd_iso(tmin), band,
                         f"{sep * 60:.0f}", pri, prog))
        tp.table(["Time (UTC)", "Band", "Off-axis [arcmin]",
                  "Priority", "Program"], rows)
    elif sched_ok:
        if horizon_h is not None:
            tp.info("No scheduled observation in the published "
                    f"window (reaches ~{horizon_h:.0f} h ahead)")
        else:
            tp.info("No scheduled observation in the published "
                    "window")
        stats = scheduled_region_stats(visits, ra, dec, now)
        if stats["pointings"]:
            band_str = ", ".join(stats["bands"]) or "-"
            night_word = ("night" if stats["nights"] == 1
                          else "nights")
            tp.info(f'{stats["pointings"]} pointings within '
                    f'~{REGION_RADIUS_DEG:.0f} deg planned on '
                    f'{stats["nights"]} {night_word} '
                    f'(bands: {band_str})')
        else:
            tp.info(f"No pointings within "
                    f"~{REGION_RADIUS_DEG:.0f} deg planned "
                    "in the window")
        if (stats["nearest_mjd"] is not None
                and stats["nearest_sep"] <= NEAREST_REPORT_DEG):
            tp.info(f'Closest scheduled pointing ~'
                    f'{fmt_mjd_iso(stats["nearest_mjd"])}: '
                    f'{stats["nearest_sep"]:.1f} deg away, '
                    f'{stats["nearest_band"]}-band')

    tp.info("Schedule viewer, pointings near this field: "
            f"{osc8_link(schedule_viewer_url(ra, dec, sched_hours))}")

    exp_ok = True
    try:
        rows, exp_ok = exposure_rows(ra, dec, days=days)
    except Exception as e:  # network/parse surprises
        tp.warn(f"Exposure history query failed: {e}")
        rows = []
        exp_ok = False

    if not exp_ok:
        tp.info("Exposure history unavailable; cannot check past "
                "coverage")
        return

    nights = covered_nights(rows, ra, dec)
    if nights:
        keys = sorted(nights)
        last_mjd = max(m for m, _ in nights[keys[-1]])
        bands = sorted({e.get("band", "?") for es in nights.values()
                        for _, e in es})
        word = "night" if len(keys) == 1 else "nights"
        tp.kv("Coverage history",
              f"{len(keys)} {word} in {days} d, "
              f"last {iso_date(last_mjd)}")
        tp.kv("Bands", ", ".join(bands))
    else:
        tp.info(f"No exposures cover this position in the last "
                f"{days} d")


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(
        prog="lsstcheck",
        description="LSST/TNS cross-match and Rubin schedule lookup.",
    )
    ap.add_argument("target", nargs="+",
                    help="TNS name, survey name, diaObjectId, or RA Dec")
    ap.add_argument("--radius", type=float, default=15.0,
                    help="LASAIR cone radius in arcsec (default 15)")
    ap.add_argument("--tns-radius", type=float, default=5.0,
                    help="TNS cone radius in arcsec (default 5)")
    ap.add_argument("--days", type=int, default=EXPOSURE_DAYS,
                    help="days of exposure history to report")
    ap.add_argument("--sched-hours", type=int, default=SCHEDULE_HOURS,
                    help="schedule look-ahead hours, 1-48 (default 48)")
    ap.add_argument("--refresh-tns", action="store_true",
                    help="force TNS index rebuild")
    ap.add_argument("--live-tns", action="store_true",
                    help="live per-object check on wis-tns.org "
                         "(name and diaObjectId inputs)")
    ap.add_argument("--plot", action="store_true",
                    help="show the LASAIR lightcurve in a plot window")
    ap.add_argument("--save", action="store_true",
                    help="save the lightcurve plot and table to the "
                         "current directory")
    ap.add_argument("--plot-out", metavar="FILE",
                    help="PNG path for --save "
                         "(default lsstcheck_<id>_lightcurve.png)")
    args = ap.parse_args()

    target = parse_target(args.target)
    if target is None:
        tp.die("Could not parse target; see --help")

    ra = dec = None
    coords_source = None
    tns_rows = []

    # ---- TNS: resolve names, get alternative names and coordinates ----
    cat = None
    try:
        cat = TnsCatalog(refresh=args.refresh_tns)
    except (RuntimeError, sqlite3.Error, OSError) as e:
        tp.warn(f"TNS catalog unavailable: {e}")

    if cat is not None:
        if target["kind"] in ("name", "lsst_name"):
            tns_rows = cat.find_name(target["raw"])
            if not tns_rows and target.get("dia_id"):
                tns_rows = cat.by_dia_id(target["dia_id"])
            if tns_rows and target["kind"] == "name":
                try:
                    ra = float(tns_rows[0]["ra"])
                    dec = float(tns_rows[0]["dec"])
                    coords_source = "TNS"
                except (TypeError, ValueError):
                    pass
        elif target["kind"] == "dia_id":
            tns_rows = cat.by_dia_id(target["dia_id"])
        elif target["kind"] == "coords":
            tns_rows = cat.cone(target["ra"], target["dec"],
                                args.tns_radius)[:3]

    # live wis-tns.org check: automatic when the catalog misses, or
    # always with --live-tns. Only works for named inputs.
    live_note = None
    if target["kind"] in ("name", "lsst_name", "dia_id"):
        slugs = live_tns_slugs(target["raw"], tns_rows)
        want_live = bool(slugs) and (args.live_tns or not tns_rows)
        if want_live:
            live = TnsLive()
            live_row = None
            for slug in slugs:
                live_row = live.lookup(slug)
                if live_row is not None:
                    break
            if live_row is None:
                if not tns_rows:
                    live_note = "Live check: not found on wis-tns.org"
            elif not tns_rows:
                tns_rows = [live_row]
                if ra is None and live_row.get("ra") is not None:
                    ra, dec = live_row["ra"], live_row["dec"]
                    coords_source = "TNS (live)"
            else:
                row = tns_rows[0]
                if live_row.get("internal_names"):
                    row["internal_names"] = live_row["internal_names"]
                    row["_live_names"] = live_row["_live_names"]
                row["_live"] = True

    if target["kind"] == "coords":
        ra, dec = target["ra"], target["dec"]
        if target.get("radius"):
            args.radius = target["radius"]
        coords_source = "input"

    # ---- LASAIR: find LSST objects ----
    lasair = LasairWeb()
    lasair_objs = []
    obj_page_info = None
    queries = []
    if ra is not None:
        queries.append(f"{ra:.6f} {dec:.6f} {args.radius:g}")
    if target["kind"] in ("name", "lsst_name"):
        queries.append(target["raw"])
    if target["kind"] in ("dia_id", "lsst_name"):
        queries.append(target["dia_id"])

    try:
        for q in queries:
            for obj in lasair.search(q):
                if not any(o["id"] == obj["id"] for o in lasair_objs):
                    lasair_objs.append(obj)
    except (requests.RequestException, RuntimeError, ValueError) as e:
        tp.warn(f"LASAIR search failed: {e}")

    # nearest match first; objects without a separation sort last
    lasair_objs.sort(key=lambda o: o.get("sep", 1e9))

    # coords/details from the first object's page (also covers id-only input)
    if lasair_objs:
        try:
            obj_page_info = lasair.object_page(lasair_objs[0]["id"])
        except Exception:
            obj_page_info = None
        if ra is None and obj_page_info and obj_page_info[0]:
            ra, dec = obj_page_info[0]
            coords_source = "LASAIR"
    if ra is None:
        for obj in lasair_objs:
            if obj.get("ra") is not None and obj.get("dec") is not None:
                ra, dec = obj["ra"], obj["dec"]
                coords_source = "LASAIR"
                break

    # ---- print ----
    print()
    tp.header("Target")
    if target["kind"] == "name":
        tp.info(f"Name: {target['raw']}")
    elif target["kind"] in ("dia_id", "lsst_name"):
        tp.info(f"LSST ID: {target['dia_id']}")
    if ra is not None:
        tp.info(f"Position: {ra:.6f}, {dec:.6f}"
                + (f"  ({coords_source})" if coords_source else ""))
        if dec > 15.0:
            tp.warn(f"Dec {dec:+.1f} is near or past the northern edge "
                    "of the LSST survey footprint; coverage may be rare")

    detections = (obj_page_info[1]
                  if obj_page_info else None)
    print_tns_section(tns_rows,
                      cat.csv_date if cat is not None else None,
                      live_note)
    print_lsst_section(lasair_objs, tns_rows, detections)

    if ra is None:
        tp.die("Could not determine coordinates for this target")

    sched_hours = min(48, max(1, args.sched_hours))
    print_schedule_section(ra, dec, args.days, sched_hours)

    if args.plot or args.save:
        phot = obj_page_info[2] if obj_page_info else []
        if phot and lasair_objs:
            oid = lasair_objs[0]["id"]
            title = f"LSST {oid}"
            if tns_rows and tns_rows[0].get("name"):
                title = f"{tns_rows[0]['name']} / {oid}"
            try:
                if args.save:
                    png = (args.plot_out
                           or f"lsstcheck_{oid}_lightcurve.png")
                    csv_path = str(Path(png).with_suffix(".csv"))
                    fig = lightcurve_fig(phot, title)
                    fig.savefig(png, dpi=150)
                    write_lightcurve_csv(csv_path, phot)
                    tp.info(f"Lightcurve plot saved: {png}")
                    tp.info(f"Lightcurve table saved: {csv_path}")
                else:
                    import matplotlib.pyplot as plt
                    fig = lightcurve_fig(phot, title)
                    plt.show()
                    plt.close(fig)
            except Exception as e:
                tp.warn(f"Plot failed: {e}")
        else:
            tp.warn("--plot/--save: no LASAIR photometry "
                    "for this target")

    print()
    tp.header("Links")
    if lasair_objs:
        oid = lasair_objs[0]["id"]
        tp.info(f"LASAIR object: "
                f"{osc8_link(f'{LASAIR_BASE}/objects/{oid}/')}")
    tp.info(f"LASAIR cone search: "
            f"{osc8_link(f'{LASAIR_BASE}/search/{ra:.6f},{dec:.6f},'
                        f'{args.radius:g}')}")
    tns_slug = None
    if tns_rows and tns_rows[0].get("name"):
        tns_slug = tns_rows[0]["name"]
    elif target["kind"] == "name":
        tns_slug = tns_key(target["raw"])
    if tns_slug:
        tp.info(f"TNS object: "
                f"{osc8_link(TNS_LIVE_BASE + tns_slug)}")
    tp.info(f"Pointings skymap: {osc8_link(skymap_url(sched_hours))}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
